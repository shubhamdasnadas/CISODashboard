PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cisodashboard
DB_USER=postgres
DB_PASSWORD=root
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=8h
APP_URL=http://localhost:5173

# ─── License & Deployment Configuration ──────────────────────────────────────
# Deployment Mode: online (hosted multi-tenant SaaS) or offline (client on-premise install)
DEPLOYMENT_MODE=online

# Vendor SuperAdmin contact email for offline license expiration alerts & requests
VENDOR_SUPERADMIN_EMAIL=support@techsec.com

# Pre-expiry warning notification thresholds in days (comma-separated, default: 30,15,7)
TOKEN_WARN_DAYS=30,15,7

# Cryptographic Keys for Offline Tamper-Proof License Signing & Verification:
# - Offline client installations require LICENSE_PUBLIC_KEY (PEM format)
# - Vendor SuperAdmin key generation CLI requires LICENSE_PRIVATE_KEY (keep secret!)
# (Run `node backend/scripts/generate-license-keys.js` to generate a new RSA pair)
LICENSE_PUBLIC_KEY=
LICENSE_PRIVATE_KEY=

# ─── SMTP Email Notifications ────────────────────────────────────────────────
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@ciso.local

# ─── Redis Cache Layer (Optional) ────────────────────────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
